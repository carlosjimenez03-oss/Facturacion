# Ambiente de PRUEBAS (desarrollo). DGII: TesteCF (sin validez fiscal).
# No contiene secretos reales: valores de ejemplo seguros para trabajar localmente.
APP_ENV=test
APP_NAME="Facturacion Electronica RD - Test"
DEBUG=true
LOG_LEVEL=DEBUG

EMISOR_RNC=101000000
DGII_API_USER=usuario.pruebas
DGII_API_PASSWORD=

CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

DATABASE_URL=sqlite:///./facturacion_test.db
ALLOWED_ORIGINS=["*"]
