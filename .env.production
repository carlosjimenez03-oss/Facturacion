# Ambiente de PRODUCCION. DGII: eCF (comprobantes con validez fiscal real).
# Ninguna credencial ni RNC real se commitea aqui: se inyectan como secretos
# desde el pipeline de CI/CD (ver .github/workflows/deploy-prod.yml).
APP_ENV=production
APP_NAME="Facturacion Electronica RD"
DEBUG=false
LOG_LEVEL=WARNING

EMISOR_RNC=
DGII_API_USER=
DGII_API_PASSWORD=

CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

DATABASE_URL=postgresql://facturacion:CHANGE_ME@db-prod:5432/facturacion_prod
ALLOWED_ORIGINS=["https://facturacion.example.do"]
