# Ambiente de PRODUCCION. DGII: eCF (comprobantes con validez fiscal real).
# Ninguna credencial real se commitea aqui: se inyecta como secreto desde el
# pipeline de CI/CD (ver .github/workflows/deploy-prod.yml). El certificado
# .p12 se monta como volumen, nunca se incluye en la imagen ni en este archivo.
# Compartido por todos los módulos (services/<modulo>) vía libs/ecf_common/settings.py.
APP_ENV=production
DEBUG=false
LOG_LEVEL=WARNING

EMISOR_RNC=
CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

ALLOWED_ORIGINS=["https://facturacion.example.do"]
