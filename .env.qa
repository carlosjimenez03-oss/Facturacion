# Ambiente de QA / CERTIFICACION. DGII: CerteCF (certificacion formal ante la DGII).
# Las credenciales reales (EMISOR_RNC, CERTIFICADO_PASSWORD) NO se commitean
# aqui: se inyectan como secretos desde el pipeline de CI/CD (ver
# .github/workflows/deploy-qa.yml). El certificado .p12 se monta como
# volumen, nunca se incluye en la imagen ni en este archivo.
# Compartido por todos los módulos (services/<modulo>) vía libs/ecf_common/settings.py.
APP_ENV=qa
DEBUG=false
LOG_LEVEL=INFO

EMISOR_RNC=
CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

ALLOWED_ORIGINS=["https://qa.facturacion.example.do"]
