# Ambiente de QA / CERTIFICACION. DGII: CerteCF (certificacion formal ante la DGII).
# Las credenciales y el RNC real del emisor NO se commitean aqui: se inyectan
# como secretos desde el pipeline de CI/CD (ver .github/workflows/deploy-qa.yml).
APP_ENV=qa
APP_NAME="Facturacion Electronica RD - QA"
DEBUG=false
LOG_LEVEL=INFO

EMISOR_RNC=
DGII_API_USER=
DGII_API_PASSWORD=

CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

DATABASE_URL=postgresql://facturacion:CHANGE_ME@db-qa:5432/facturacion_qa
ALLOWED_ORIGINS=["https://qa.facturacion.example.do"]
