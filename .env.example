# Plantilla de variables de entorno. Copiar a .env.<ambiente> y completar.
# APP_ENV determina el .env.<ambiente> que se carga y el ambiente DGII asociado:
#   test       -> DGII TesteCF  (pruebas del contribuyente, sin validez fiscal)
#   qa         -> DGII CerteCF  (certificacion formal ante la DGII)
#   production -> DGII eCF      (produccion, comprobantes con validez fiscal)
APP_ENV=test
APP_NAME="Facturacion Electronica RD"
DEBUG=true
LOG_LEVEL=INFO

# Datos del emisor autorizado por la DGII.
EMISOR_RNC=
DGII_API_USER=
DGII_API_PASSWORD=

# Certificado digital (INDOTEL) para firmar los e-CF. No commitear el .p12 real.
CERTIFICADO_PATH=certs/emisor.p12
CERTIFICADO_PASSWORD=

DATABASE_URL=sqlite:///./facturacion.db
ALLOWED_ORIGINS=["*"]
